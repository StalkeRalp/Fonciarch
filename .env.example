# Supabase est le seul backend de FONCIARCH.
# Variables uniquement côté serveur. Ne jamais utiliser le préfixe NEXT_PUBLIC pour la clé secrète.
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_SECRET_KEY=REMPLACER_PAR_LA_CLE_SECRETE_SERVEUR

# Facultatif : clés publiques pour une future intégration Auth côté client.
# Elles ne remplacent PAS la clé secrète serveur ci-dessus.
SUPABASE_PUBLISHABLE_KEY=REMPLACER_PAR_LA_CLE_SB_PUBLISHABLE
SUPABASE_ANON_KEY=REMPLACER_PAR_L_ANCIENNE_CLE_ANON_SI_NECESSAIRE
